{
  "root": "main",
  "elements": {
    "main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "header",
        "metrics",
        "tabs"
      ]
    },
    "header": {
      "type": "Card",
      "props": {
        "title": "High-Severity Clinical History Review",
        "description": "surfaces only the consequential diagnoses, safety risks, high-signal medications, labs, notes, and vital trends.",
        "maxWidth": "full"
      },
      "children": [
        "patient",
        "intro",
        "stance"
      ]
    },
    "patient": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "Mock patient: ${/patient/name} · ${/patient/encounter} · As of ${/patient/asOf}"
        },
        "muted": true
      },
      "children": []
    },
    "intro": {
      "type": "Text",
      "props": {
        "content": {
          "$state": "/intro"
        }
      },
      "children": []
    },
    "stance": {
      "type": "Callout",
      "props": {
        "type": "warning",
        "title": "Protocol stance",
        "content": "Rank by potential for near-term harm — bleeding and decompensation, self-harm, withdrawal and sedation, falls, and other destabilizing conditions. Don’t waste attention on stable routine problems unless they change management."
      },
      "children": []
    },
    "metrics": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md"
      },
      "children": [
        "metric-condition",
        "metric-alert",
        "metric-vital",
        "metric-med"
      ]
    },
    "metric-condition": {
      "type": "Metric",
      "props": {
        "label": "Active conditions",
        "value": {
          "$template": "${/summary/activeConditions}"
        },
        "detail": "Only clinically consequential ones get classified.",
        "trend": "neutral"
      },
      "children": []
    },
    "metric-alert": {
      "type": "Metric",
      "props": {
        "label": "Active alerts",
        "value": {
          "$template": "${/summary/activeAlerts}"
        },
        "detail": "Mental-health and housing or fall context.",
        "trend": "up"
      },
      "children": []
    },
    "metric-vital": {
      "type": "Metric",
      "props": {
        "label": "High-signal vitals",
        "value": {
          "$template": "${/summary/highSignalVitals}"
        },
        "detail": "Vital-trend graph flags abnormality burden.",
        "trend": "up"
      },
      "children": []
    },
    "metric-med": {
      "type": "Metric",
      "props": {
        "label": "High-signal meds",
        "value": {
          "$template": "${/summary/highSignalMeds}"
        },
        "detail": "Sedative, bleeding, kidney, liver, and rhythm risks.",
        "trend": "up"
      },
      "children": []
    },
    "tabs": {
      "type": "Tabs",
      "props": {
        "defaultValue": "severity",
        "tabs": [
          {
            "value": "severity",
            "label": "Severity ranking"
          },
          {
            "value": "vitals",
            "label": "Vital trends"
          },
          {
            "value": "labs",
            "label": "Labs / liver-anemia"
          },
          {
            "value": "evidence",
            "label": "Evidence"
          }
        ]
      },
      "children": [
        "tab-severity",
        "tab-vitals",
        "tab-labs",
        "tab-evidence"
      ]
    },
    "tab-severity": {
      "type": "TabContent",
      "props": {
        "value": "severity"
      },
      "children": [
        "severity-grid",
        "route-notes"
      ]
    },
    "severity-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "severity-bar",
        "severity-pie"
      ]
    },
    "severity-bar": {
      "type": "BarChart",
      "props": {
        "title": "Near-term severity ranking",
        "data": {
          "$state": "/severity"
        },
        "xKey": "area",
        "yKey": "score",
        "color": "#b42318",
        "height": 280
      },
      "children": []
    },
    "severity-pie": {
      "type": "PieChart",
      "props": {
        "title": "Where risk weight sits",
        "data": {
          "$state": "/riskMix"
        },
        "nameKey": "area",
        "valueKey": "weight",
        "height": 280
      },
      "children": []
    },
    "route-notes": {
      "type": "Accordion",
      "props": {
        "type": "multiple",
        "items": [
          {
            "title": "Medical-decompensation route · urgent medical review",
            "content": "Looks for severe diagnoses paired with bleeding, anemia, organ dysfunction, infection, abnormal labs, or high-risk therapy. Mock finding: anemia, thrombocytopenia, AKI, liver injury, hypotension, and apixaban require urgent medical and lab/bleeding review. Keep the horse: acute blood loss or medication-related bleeding. Check the zebra: occult GI bleeding or evolving hepatic failure."
          },
          {
            "title": "Behavioral-safety route · immediate safety assessment",
            "content": "Looks for suicide attempts, recent self-harm, active ideation, behavioral alerts, and observation precautions. Mock finding: recent medication overdose and active suicide-risk alert require observation, mental-health notification, and safety assessment."
          },
          {
            "title": "Medication-and-substance route · reconciliation and withdrawal monitoring",
            "content": "Looks for intoxication, withdrawal, detox treatment, missed or unsafe medications, duplication, sedation, bleeding, kidney, liver, rhythm, or fall risk. Mock finding: lorazepam, gabapentin, apixaban, and overdose history require medication reconciliation and withdrawal/respiratory monitoring."
          },
          {
            "title": "Vital-trend route · escalate deterioration",
            "content": "Reads serial vitals rather than relying on one normal value. Mock finding: rising heart rate, hypotension, low oxygen saturation, and tachypnea show worsening burden and change management."
          },
          {
            "title": "Fall / functional and care-transition route",
            "content": "Looks for falls, head injury, functional limitation, special housing, sedation, pending procedures, outside-transfer follow-up, incomplete referrals, and discharge barriers. Mock finding: fall precautions and unresolved transfer/GI follow-up require nursing and case-management action."
          },
          {
            "title": "Mundane suppression rule",
            "content": "Stable, routine, minor, or administrative findings are excluded and trigger no follow-up unless they alter a severe risk. Mock example: chronic dyslipidemia is suppressed."
          }
        ]
      },
      "children": []
    },
    "tab-vitals": {
      "type": "TabContent",
      "props": {
        "value": "vitals"
      },
      "children": [
        "vital-note",
        "vital-line",
        "vital-bar",
        "vital-table"
      ]
    },
    "vital-note": {
      "type": "Callout",
      "props": {
        "type": "info",
        "title": "Vital-trend view",
        "content": "Serial readings are weighted by abnormality, persistence, clustering, and deterioration. A reassuring single reading does not override an active severe trend."
      },
      "children": []
    },
    "vital-line": {
      "type": "LineChart",
      "props": {
        "title": "Vital-sign severity over time",
        "data": {
          "$state": "/vitalTrend"
        },
        "xKey": "time",
        "yKey": "severity",
        "color": "#c2410c",
        "height": 260
      },
      "children": []
    },
    "vital-bar": {
      "type": "BarChart",
      "props": {
        "title": "Abnormality burden by vital",
        "data": {
          "$state": "/vitalBurden"
        },
        "xKey": "vital",
        "yKey": "burden",
        "color": "#d97706",
        "height": 240
      },
      "children": []
    },
    "vital-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/vitals"
        },
        "columns": [
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "vital",
            "label": "Vital"
          },
          {
            "key": "value",
            "label": "Value"
          },
          {
            "key": "unit",
            "label": "Unit"
          },
          {
            "key": "flagged",
            "label": "Flagged"
          },
          {
            "key": "why",
            "label": "Why"
          }
        ],
        "emptyMessage": "No vitals available."
      },
      "children": []
    },
    "tab-labs": {
      "type": "TabContent",
      "props": {
        "value": "labs"
      },
      "children": [
        "lab-bar",
        "lab-table"
      ]
    },
    "lab-bar": {
      "type": "BarChart",
      "props": {
        "title": "Lab-signal burden by test",
        "data": {
          "$state": "/labBurden"
        },
        "xKey": "test",
        "yKey": "burden",
        "color": "#7f1d1d",
        "height": 280
      },
      "children": []
    },
    "lab-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/labs"
        },
        "columns": [
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "lab",
            "label": "Lab"
          },
          {
            "key": "value",
            "label": "Value"
          },
          {
            "key": "unit",
            "label": "Unit"
          },
          {
            "key": "range",
            "label": "Reference range"
          },
          {
            "key": "flagged",
            "label": "Flagged"
          }
        ],
        "emptyMessage": "No labs available."
      },
      "children": []
    },
    "tab-evidence": {
      "type": "TabContent",
      "props": {
        "value": "evidence"
      },
      "children": [
        "evidence-grid",
        "med-card",
        "actions"
      ]
    },
    "evidence-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "condition-table",
        "alert-table"
      ]
    },
    "condition-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/conditions"
        },
        "columns": [
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "condition",
            "label": "Condition"
          },
          {
            "key": "status",
            "label": "Status"
          }
        ],
        "emptyMessage": "No consequential conditions available."
      },
      "children": []
    },
    "alert-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/alerts"
        },
        "columns": [
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "alert",
            "label": "Alert"
          },
          {
            "key": "status",
            "label": "Status"
          }
        ],
        "emptyMessage": "No active alerts available."
      },
      "children": []
    },
    "med-card": {
      "type": "Card",
      "props": {
        "title": "High-signal medication review",
        "description": "Mock medication findings that can change near-term care.",
        "maxWidth": "full"
      },
      "children": [
        "med-table"
      ]
    },
    "med-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/meds"
        },
        "columns": [
          {
            "key": "medication",
            "label": "Medication"
          },
          {
            "key": "risk",
            "label": "Clinical risk"
          },
          {
            "key": "status",
            "label": "Disposition"
          }
        ]
      },
      "children": []
    },
    "actions": {
      "type": "Callout",
      "props": {
        "type": "important",
        "title": "Severe-only follow-ups",
        "content": "Urgent medical review; repeat CBC, renal and liver testing; bleeding assessment; mental-health notification and safety observation; withdrawal and respiratory monitoring; medication reconciliation; vital-trend escalation; fall precautions; chase outside-transfer records; close the pending GI referral; and resolve discharge-planning barriers. No action is generated for stable dyslipidemia."
      },
      "children": []
    }
  },
