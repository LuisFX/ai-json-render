{
  "root": "",
  "elements": {
    "vital-lines": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "vital-overlay-note",
        "vital-overlay-chart",
        "vital-overlay-legend"
      ]
    },
    "vital-overlay-note": {
      "type": "Text",
      "props": {
        "content": "All four vital types are overlaid using a normalized 0–10 severity score so trends can be compared despite different units. Actual values remain available in the table below."
      },
      "children": []
    },
    "vital-overlay-chart": {
      "type": "LineChart",
      "props": {
        "title": "Overlay: normalized vital-severity trends over one year",
        "data": {
          "$state": "/vitalOverlay"
        },
        "xKey": "when",
        "yKey": "bloodPressure",
        "height": 340
      },
      "children": []
    },
    "vital-overlay-legend": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "sm"
      },
      "children": [
        "legend-bp",
        "legend-temp",
        "legend-hr",
        "legend-rr"
      ]
    },
    "legend-bp": {
      "type": "Badge",
      "props": {
        "text": "● Blood pressure",
        "variant": "destructive"
      },
      "children": []
    },
    "legend-temp": {
      "type": "Badge",
      "props": {
        "text": "● Temperature",
        "variant": "secondary"
      },
      "children": []
    },
    "legend-hr": {
      "type": "Badge",
      "props": {
        "text": "● Heart rate",
        "variant": "default"
      },
      "children": []
    },
    "legend-rr": {
      "type": "Badge",
      "props": {
        "text": "● Respiratory rate",
        "variant": "outline"
      },
      "children": []
    }
  },
