{
  "root": "patient-dashboard",
  "elements": {
    "patient-dashboard": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg",
        "className": "p-4"
      },
      "children": [
        "dashboard-header",
        "demo-alert",
        "summary-card",
        "priority-grid",
        "history-grid",
        "vitals-card",
        "labs-card",
        "provenance-card"
      ]
    },
    "dashboard-header": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "header-title-row",
        "header-subtitle",
        "header-separator"
      ]
    },
    "header-title-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between"
      },
      "children": [
        "dashboard-title",
        "generated-badge"
      ]
    },
    "dashboard-title": {
      "type": "Heading",
      "props": {
        "text": "Patient Chart Intelligence",
        "level": "h1"
      },
      "children": []
    },
    "generated-badge": {
      "type": "Badge",
      "props": {
        "text": {
          "$template": "Generated ${/patient/generated}"
        },
        "variant": "outline"
      },
      "children": []
    },
    "header-subtitle": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "${/patient/name} · MRN ${/patient/mrn} · ${/patient/dobAge} · ${/patient/encounter} · Data coverage: ${/patient/coverage}"
        },
        "muted": true
      },
      "children": []
    },
    "header-separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "demo-alert": {
      "type": "Alert",
      "props": {
        "title": "Synthetic demonstration record",
        "message": "This dashboard contains illustrative data only. Production output must come from authenticated chart sources and undergo clinician review.",
        "type": "info"
      },
      "children": []
    },
    "summary-card": {
      "type": "Card",
      "props": {
        "title": "Clinical Summary",
        "description": "Concise synthesis of the latest intake and longitudinal chart history",
        "maxWidth": "full"
      },
      "children": [
        "summary-text",
        "summary-callout"
      ]
    },
    "summary-text": {
      "type": "Text",
      "props": {
        "content": {
          "$state": "/summary/narrative"
        }
      },
      "children": []
    },
    "summary-callout": {
      "type": "Callout",
      "props": {
        "type": "important",
        "title": "Items requiring clinical review",
        "content": {
          "$state": "/summary/priority"
        }
      },
      "children": []
    },
    "priority-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "lg"
      },
      "children": [
        "pt051-card",
        "mental-card"
      ]
    },
    "pt051-card": {
      "type": "Card",
      "props": {
        "title": "Most Recent PT051",
        "description": {
          "$template": "${/pt051/date} · ${/pt051/status} · ${/pt051/author}"
        },
        "maxWidth": "full"
      },
      "children": [
        "pt051-status-row",
        "pt051-reason",
        "pt051-symptoms",
        "pt051-substance",
        "pt051-social",
        "pt051-disposition"
      ]
    },
    "pt051-status-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": [
        "pt051-signed-badge",
        "pt051-location-badge"
      ]
    },
    "pt051-signed-badge": {
      "type": "Badge",
      "props": {
        "text": {
          "$state": "/pt051/status"
        },
        "variant": "default"
      },
      "children": []
    },
    "pt051-location-badge": {
      "type": "Badge",
      "props": {
        "text": {
          "$state": "/pt051/location"
        },
        "variant": "secondary"
      },
      "children": []
    },
    "pt051-reason": {
      "type": "Callout",
      "props": {
        "type": "info",
        "title": "Reason for intake",
        "content": {
          "$state": "/pt051/reason"
        }
      },
      "children": []
    },
    "pt051-symptoms": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "Symptoms: ${/pt051/symptoms}"
        }
      },
      "children": []
    },
    "pt051-substance": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "Substance use: ${/pt051/substanceUse}"
        }
      },
      "children": []
    },
    "pt051-social": {
      "type": "Text",
      "props": {
        "content": {
          "$template": "Social and functional context: ${/pt051/social}"
        }
      },
      "children": []
    },
    "pt051-disposition": {
      "type": "Callout",
      "props": {
        "type": "tip",
        "title": "Documented disposition",
        "content": {
          "$state": "/pt051/disposition"
        }
      },
      "children": []
    },
    "mental-card": {
      "type": "Card",
      "props": {
        "title": "Mental Health & Safety",
        "description": "Latest screening results and longitudinal safety context",
        "maxWidth": "full"
      },
      "children": [
        "mental-metrics",
        "mental-action",
        "mental-timeline"
      ]
    },
    "mental-metrics": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "sm"
      },
      "children": [
        "phq-metric",
        "columbia-metric",
        "withdrawal-metric"
      ]
    },
    "phq-metric": {
      "type": "Metric",
      "props": {
        "label": "PHQ-9",
        "value": {
          "$state": "/mentalSummary/phq9"
        },
        "detail": "Latest completed screen",
        "trend": "up"
      },
      "children": []
    },
    "columbia-metric": {
      "type": "Metric",
      "props": {
        "label": "Columbia",
        "value": {
          "$state": "/mentalSummary/columbia"
        },
        "detail": "Latest suicide-risk assessment",
        "trend": "neutral"
      },
      "children": []
    },
    "withdrawal-metric": {
      "type": "Metric",
      "props": {
        "label": "Withdrawal Screen",
        "value": {
          "$state": "/mentalSummary/withdrawal"
        },
        "detail": "Latest documented score",
        "trend": "up"
      },
      "children": []
    },
    "mental-action": {
      "type": "Callout",
      "props": {
        "type": "warning",
        "title": "Latest documented action",
        "content": {
          "$state": "/mentalSummary/latestAction"
        }
      },
      "children": []
    },
    "mental-timeline": {
      "type": "Timeline",
      "props": {
        "items": {
          "$state": "/mentalTimeline"
        }
      },
      "children": []
    },
    "history-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "lg"
      },
      "children": [
        "conditions-card",
        "medications-card"
      ]
    },
    "conditions-card": {
      "type": "Card",
      "props": {
        "title": "Conditions",
        "description": "Active and historically relevant documented conditions",
        "maxWidth": "full"
      },
      "children": [
        "conditions-table"
      ]
    },
    "conditions-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/conditions"
        },
        "columns": [
          {
            "key": "condition",
            "label": "Condition"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "onset",
            "label": "Onset"
          },
          {
            "key": "lastDocumented",
            "label": "Last Documented"
          },
          {
            "key": "source",
            "label": "Source"
          }
        ],
        "emptyMessage": "No documented conditions found."
      },
      "children": []
    },
    "medications-card": {
      "type": "Card",
      "props": {
        "title": "Medication History",
        "description": "Active, discontinued, and patient-reported medication records",
        "maxWidth": "full"
      },
      "children": [
        "medications-table"
      ]
    },
    "medications-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/medications"
        },
        "columns": [
          {
            "key": "medication",
            "label": "Medication"
          },
          {
            "key": "dose",
            "label": "Dose"
          },
          {
            "key": "route",
            "label": "Route"
          },
          {
            "key": "frequency",
            "label": "Frequency"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "indication",
            "label": "Indication"
          },
          {
            "key": "dates",
            "label": "Dates"
          }
        ],
        "emptyMessage": "No medication records found."
      },
      "children": []
    },
    "vitals-card": {
      "type": "Card",
      "props": {
        "title": "Recent Vital-Sign Trends",
        "description": "Most recent documented observations with longitudinal context",
        "maxWidth": "full"
      },
      "children": [
        "latest-vitals-grid",
        "vitals-separator",
        "vitals-chart-grid"
      ]
    },
    "latest-vitals-grid": {
      "type": "Grid",
      "props": {
        "columns": 5,
        "gap": "sm"
      },
      "children": [
        "bp-metric",
        "hr-metric",
        "spo2-metric",
        "temp-metric",
        "weight-metric"
      ]
    },
    "bp-metric": {
      "type": "Metric",
      "props": {
        "label": "Blood Pressure",
        "value": {
          "$state": "/latestVitals/bp"
        },
        "detail": "Latest",
        "trend": "up"
      },
      "children": []
    },
    "hr-metric": {
      "type": "Metric",
      "props": {
        "label": "Heart Rate",
        "value": {
          "$state": "/latestVitals/hr"
        },
        "detail": "Latest",
        "trend": "up"
      },
      "children": []
    },
    "spo2-metric": {
      "type": "Metric",
      "props": {
        "label": "SpO₂",
        "value": {
          "$state": "/latestVitals/spo2"
        },
        "detail": "Latest",
        "trend": "neutral"
      },
      "children": []
    },
    "temp-metric": {
      "type": "Metric",
      "props": {
        "label": "Temperature",
        "value": {
          "$state": "/latestVitals/temp"
        },
        "detail": "Latest",
        "trend": "neutral"
      },
      "children": []
    },
    "weight-metric": {
      "type": "Metric",
      "props": {
        "label": "Weight",
        "value": {
          "$state": "/latestVitals/weight"
        },
        "detail": "Latest",
        "trend": "down"
      },
      "children": []
    },
    "vitals-separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "vitals-chart-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "systolic-chart",
        "diastolic-chart",
        "heart-rate-chart",
        "weight-chart"
      ]
    },
    "systolic-chart": {
      "type": "LineChart",
      "props": {
        "title": "Systolic Blood Pressure (mmHg)",
        "data": {
          "$state": "/vitals"
        },
        "xKey": "date",
        "yKey": "systolic",
        "color": "#dc2626",
        "height": 240
      },
      "children": []
    },
    "diastolic-chart": {
      "type": "LineChart",
      "props": {
        "title": "Diastolic Blood Pressure (mmHg)",
        "data": {
          "$state": "/vitals"
        },
        "xKey": "date",
        "yKey": "diastolic",
        "color": "#f97316",
        "height": 240
      },
      "children": []
    },
    "heart-rate-chart": {
      "type": "LineChart",
      "props": {
        "title": "Heart Rate (bpm)",
        "data": {
          "$state": "/vitals"
        },
        "xKey": "date",
        "yKey": "heartRate",
        "color": "#7c3aed",
        "height": 240
      },
      "children": []
    },
    "weight-chart": {
      "type": "LineChart",
      "props": {
        "title": "Weight (lb)",
        "data": {
          "$state": "/vitals"
        },
        "xKey": "date",
        "yKey": "weight",
        "color": "#2563eb",
        "height": 240
      },
      "children": []
    },
    "labs-card": {
      "type": "Card",
      "props": {
        "title": "Laboratory Results",
        "description": "Latest results with encounter-specific reference ranges and trend indicators",
        "maxWidth": "full"
      },
      "children": [
        "lab-warning",
        "labs-table",
        "screening-separator",
        "screening-heading",
        "screenings-table"
      ]
    },
    "lab-warning": {
      "type": "Callout",
      "props": {
        "type": "warning",
        "title": "Abnormal results",
        "content": "Potassium is mildly low, AST is elevated, and ethanol is above the listed reference threshold. Interpret results in clinical context and verify against the source laboratory record."
      },
      "children": []
    },
    "labs-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/labs"
        },
        "columns": [
          {
            "key": "panel",
            "label": "Panel"
          },
          {
            "key": "test",
            "label": "Test"
          },
          {
            "key": "result",
            "label": "Result"
          },
          {
            "key": "units",
            "label": "Units"
          },
          {
            "key": "reference",
            "label": "Reference Range"
          },
          {
            "key": "flag",
            "label": "Flag"
          },
          {
            "key": "collected",
            "label": "Collected"
          },
          {
            "key": "trend",
            "label": "Trend"
          }
        ],
        "emptyMessage": "No recent laboratory results found."
      },
      "children": []
    },
    "screening-separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "screening-heading": {
      "type": "Heading",
      "props": {
        "text": "Behavioral-Health Screening History",
        "level": "h3"
      },
      "children": []
    },
    "screenings-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/screenings"
        },
        "columns": [
          {
            "key": "assessment",
            "label": "Assessment"
          },
          {
            "key": "date",
            "label": "Date"
          },
          {
            "key": "score",
            "label": "Score / Risk"
          },
          {
            "key": "interpretation",
            "label": "Interpretation"
          },
          {
            "key": "source",
            "label": "Source"
          }
        ],
        "emptyMessage": "No behavioral-health screening forms found."
      },
      "children": []
    },
    "provenance-card": {
      "type": "Card",
      "props": {
        "title": "Provenance, Uncertainty & Clinical Review",
        "description": "Traceability requirements for safe use",
        "maxWidth": "full"
      },
      "children": [
        "provenance-callout",
        "source-accordion"
      ]
    },
    "provenance-callout": {
      "type": "Callout",
      "props": {
        "type": "important",
        "title": "Source-linked output",
        "content": {
          "$state": "/provenance/message"
        }
      },
      "children": []
    },
    "source-accordion": {
      "type": "Accordion",
      "props": {
        "type": "multiple",
        "items": [
          {
            "title": "How conflicting records should be handled",
            "content": "Show conflicts explicitly with dates and sources. Do not silently choose one medication, diagnosis, score, or result as authoritative."
          },
          {
            "title": "How inferred findings should be displayed",
            "content": "Keep chart-documented diagnoses separate from possible conditions inferred from narrative notes. Inferences should include confidence and supporting citations."
          },
          {
            "title": "Required clinician safeguards",
            "content": "The summary should support—not replace—clinical review. Urgent findings should follow organization-approved escalation workflows rather than relying on the generated summary alone."
          }
        ]
      },
      "children": []
    }
  },
