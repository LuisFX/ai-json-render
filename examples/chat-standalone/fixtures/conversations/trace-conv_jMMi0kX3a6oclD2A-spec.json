            "label": "Condition"
          },
          {
            "key": "status",
            "label": "Status"
          }
        ],
        "emptyMessage": "No conditions available"
      },
      "children": []
    },
    "conditions-download": {
      "type": "Button",
      "props": {
        "label": "Download CSV",
        "variant": "outline",
        "size": "default"
      },
      "children": []
    },
    "alerts-card": {
