{
  "root": "main",
  "elements": {
    "main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "header-card",
        "metrics-grid",
        "tabs"
      ]
    },
    "header-card": {
      "type": "Card",
      "props": {
        "title": "High-Severity Clinical History Review",
        "description": "Surfaces only the consequential diagnoses, safety risks, high-signal medications, labs, notes, and vital trends.",
        "maxWidth": "full"
      },
      "children": [
        "header-stack"
      ]
    },
    "header-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "intro-text",
        "protocol-callout",
        "separator-1"
      ]
    },
    "intro-text": {
      "type": "Text",
      "props": {
        "content": "Top risks for this patient: behavioral safety, medical decompensation, medication safety, and vital instability, supported by the chart evidence in [1]–[5].",
        "muted": false
      },
      "children": []
    },
    "protocol-callout": {
      "type": "Callout",
      "props": {
        "type": "warning",
        "title": "Protocol stance",
        "content": "Rank by potential for near-term harm — bleeding and decompensation, self-harm, withdrawal and sedation, falls, and other destabilizing conditions. Don't waste attention on stable routine problems unless they change management."
      },
      "children": []
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "metrics-grid": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md"
      },
      "children": [
        "metric-conditions",
        "metric-alerts",
        "metric-vitals",
        "metric-meds"
      ]
    },
    "metric-conditions": {
      "type": "Metric",
      "props": {
        "label": "Active conditions",
        "value": {
          "$state": "/headlineCounts/activeConditions"
        },
        "detail": "only the clinically consequential ones get classified",
        "trend": "neutral"
      },
      "children": []
    },
    "metric-alerts": {
      "type": "Metric",
      "props": {
        "label": "Active alerts",
        "value": {
          "$state": "/headlineCounts/activeAlerts"
        },
        "detail": "mental-health and housing or fall context",
        "trend": "up"
      },
      "children": []
    },
    "metric-vitals": {
      "type": "Metric",
      "props": {
        "label": "High-signal vitals",
        "value": {
          "$state": "/headlineCounts/highSignalVitals"
        },
        "detail": "the vital-trend graph flags the abnormality burden",
        "trend": "up"
      },
      "children": []
    },
    "metric-meds": {
      "type": "Metric",
      "props": {
        "label": "High-signal meds",
        "value": {
          "$state": "/headlineCounts/highSignalMeds"
        },
        "detail": "e.g. sedative exposure in this chart",
        "trend": "up"
      },
      "children": []
    },
    "tabs": {
      "type": "Tabs",
      "props": {
        "defaultValue": "severity",
        "tabs": [
          {
            "value": "severity",
            "label": "Severity ranking"
          },
          {
            "value": "vitals",
            "label": "Vital trends"
          },
          {
            "value": "labs",
            "label": "Labs / liver-anemia"
          },
          {
            "value": "evidence",
            "label": "Evidence"
          }
        ]
      },
      "children": [
        "tab-severity",
        "tab-vitals",
        "tab-labs",
        "tab-evidence"
      ]
    },
    "tab-severity": {
      "type": "TabContent",
      "props": {
        "value": "severity"
      },
      "children": [
        "severity-grid",
        "routes-accordion"
      ]
    },
    "severity-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "severity-bar-card",
        "severity-pie-card"
      ]
    },
    "severity-bar-card": {
      "type": "Card",
      "props": {
        "title": "Severity ranking",
        "description": "Higher means more consequential in the next hours to days.",
        "maxWidth": "full"
      },
      "children": [
        "severity-bar-chart"
      ]
    },
    "severity-bar-chart": {
      "type": "BarChart",
      "props": {
        "data": {
          "$state": "/severityBarData"
        },
        "xKey": "area",
        "yKey": "score",
        "color": "#c2410c",
        "height": 280
      },
      "children": []
    },
    "severity-pie-card": {
      "type": "Card",
      "props": {
        "title": "Risk weight split",
        "description": "Where this patient's near-term risk sits across the severe domains.",
        "maxWidth": "full"
      },
      "children": [
        "severity-pie-chart"
      ]
    },
    "severity-pie-chart": {
      "type": "PieChart",
      "props": {
        "data": {
          "$state": "/severityPieData"
        },
        "nameKey": "name",
        "valueKey": "value",
        "height": 280
      },
      "children": []
    },
    "routes-accordion": {
      "type": "Accordion",
      "props": {
        "type": "multiple",
        "items": [
          {
            "title": "Medical decompensation route",
            "content": "Looks for a severe diagnosis plus bleeding risk, organ dysfunction, infection, or a high-risk medication that could change care in the next hours to days. Horse: upper GI bleed with anemia and anticoagulation. Zebra: occult malignancy or variceal source if instability worsens."
          },
          {
            "title": "Behavioral safety route",
            "content": "Looks for suicide attempt, self-harm, active ideation, behavioral-health alerts, or observation precautions. Horse: depressive crisis with active suicidal ideation. Zebra: delirium or intoxication amplifying risk."
          },
          {
            "title": "Medication and substance route",
            "content": "Looks for substance use, detox/intoxication/withdrawal, or sedative exposure that intersects with psychiatric, liver, fall, or vital-sign risk. Keep it quiet unless it changes the severe picture."
          },
          {
            "title": "Vital-trend route",
            "content": "Looks for abnormal vital clusters, deterioration, or missing monitoring; it should rank the burden over time, not overreact to a single normal value."
          },
          {
            "title": "Mundane suppression rule",
            "content": "Stable, routine, minor, or administrative problems stay out of the ranked list and do not trigger follow-up unless they change severe-risk management."
          }
        ]
      },
      "children": []
    },
    "tab-vitals": {
      "type": "TabContent",
      "props": {
        "value": "vitals"
      },
      "children": [
        "vitals-callout",
        "vitals-line-card",
        "vitals-bar-card",
        "vitals-table-card"
      ]
    },
    "vitals-callout": {
      "type": "Callout",
      "props": {
        "type": "info",
        "title": "Vital trends",
        "content": "This view summarizes the burden and direction of abnormal vitals over time. A single reassuring recent value does not cancel a broader instability trend."
      },
      "children": []
    },
    "vitals-line-card": {
      "type": "Card",
      "props": {
        "title": "Vital severity over time",
        "description": "Trend of the abnormality burden across the charted vitals.",
        "maxWidth": "full"
      },
      "children": [
        "vitals-line-chart"
      ]
    },
    "vitals-line-chart": {
      "type": "LineChart",
      "props": {
        "data": {
          "$state": "/vitalTrend"
        },
        "xKey": "time",
        "yKey": "severity",
        "color": "#2563eb",
        "height": 240
      },
      "children": []
    },
    "vitals-bar-card": {
      "type": "Card",
      "props": {
        "title": "Abnormality burden by vital",
        "description": "Which vital signs are contributing most to the severity picture.",
        "maxWidth": "full"
      },
      "children": [
        "vitals-bar-chart"
      ]
    },
    "vitals-bar-chart": {
      "type": "BarChart",
      "props": {
        "data": {
          "$state": "/vitalByType"
        },
        "xKey": "type",
        "yKey": "burden",
        "color": "#dc2626",
        "height": 220
      },
      "children": []
    },
    "vitals-table-card": {
      "type": "Card",
      "props": {
        "title": "Vital readings",
        "description": "When it was taken, which vital, the value and unit, whether it is flagged, and why.",
        "maxWidth": "full"
      },
      "children": [
        "vitals-table"
      ]
    },
    "vitals-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/vitals"
        },
        "columns": [
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "type",
            "label": "Vital"
          },
          {
            "key": "value",
            "label": "Value"
          },
          {
            "key": "unit",
            "label": "Unit"
          },
          {
            "key": "flagged",
            "label": "Flagged"
          },
          {
            "key": "reason",
            "label": "Why"
          }
        ],
        "emptyMessage": "No vitals available"
      },
      "children": []
    },
    "tab-labs": {
      "type": "TabContent",
      "props": {
        "value": "labs"
      },
      "children": [
        "labs-bar-card",
        "labs-table-card"
      ]
    },
    "labs-bar-card": {
      "type": "Card",
      "props": {
        "title": "Lab-signal burden",
        "description": "Burden by test, emphasizing labs that alter near-term management.",
        "maxWidth": "full"
      },
      "children": [
        "labs-bar-chart"
      ]
    },
    "labs-bar-chart": {
      "type": "BarChart",
      "props": {
        "data": {
          "$state": "/labSignals"
        },
        "xKey": "test",
        "yKey": "burden",
        "color": "#7c3aed",
        "height": 240
      },
      "children": []
    },
    "labs-table-card": {
      "type": "Card",
      "props": {
        "title": "Labs / liver-anemia",
        "description": "When, which lab, the value and unit, the reference range, and whether it is flagged.",
        "maxWidth": "full"
      },
      "children": [
        "labs-table",
        "labs-download"
      ]
    },
    "labs-table": {
      "type": "Table",
      "props": {
        "data": {
          "$state": "/labs"
        },
        "columns": [
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "lab",
            "label": "Lab"
          },
          {
            "key": "value",
            "label": "Value"
          },
          {
            "key": "unit",
            "label": "Unit"
          },
          {
            "key": "range",
            "label": "Reference range"
          },
          {
            "key": "flagged",
            "label": "Flagged"
          }
        ],
        "emptyMessage": "No labs available"
      },
      "children": []
    },
    "labs-download": {
      "type": "Button",
      "props": {
        "label": "Download CSV",
        "variant": "outline",
        "size": "default"
      },
      "children": []
    },
    "tab-evidence": {
      "type": "TabContent",
      "props": {
        "value": "evidence"
      },
      "children": [
        "evidence-grid"
      ]
    },
    "evidence-grid": {
