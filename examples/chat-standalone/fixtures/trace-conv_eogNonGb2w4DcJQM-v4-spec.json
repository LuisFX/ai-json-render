{
  "root": "main",
  "elements": {
    "main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg",
        "align": "stretch",
        "className": "dark"
      },
      "children": [
        "header",
        "summary-grid",
        "trend-grid",
        "history-card",
        "details-tabs"
      ]
    },
    "header": {
      "type": "Card",
      "props": {
        "title": "Crypto Dashboard",
        "description": "Bitcoin, Ethereum, and Solana market snapshot",
        "maxWidth": "full"
      },
      "children": [
        "header-content"
      ]
    },
    "header-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "header-heading",
        "header-callout"
      ]
    },
    "header-heading": {
      "type": "Heading",
      "props": {
        "text": "Live Crypto Overview",
        "level": "h1"
      },
      "children": []
    },
    "header-callout": {
      "type": "Callout",
      "props": {
        "type": "important",
        "title": "Market context",
        "content": "Prices, market caps, and historical trends are based on the latest available data for BTC, ETH, and SOL."
      },
      "children": []
    },
    "summary-grid": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "btc-card",
        "eth-card",
        "sol-card"
      ]
    },
    "btc-card": {
      "type": "Card",
      "props": {
        "title": "Bitcoin (BTC)",
        "maxWidth": "full"
      },
      "children": [
        "btc-stack"
      ]
    },
    "btc-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "btc-price",
        "btc-kpis"
      ]
    },
    "btc-price": {
      "type": "Metric",
      "props": {
        "label": "Current Price",
        "value": {
          "$state": "/state/priceFormat/bitcoin/price"
        },
        "detail": {
          "$state": "/state/priceFormat/bitcoin/detail"
        },
        "trend": "down"
      },
      "children": []
    },
    "btc-metrics": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "sm"
      },
      "children": [
        "btc-mcap",
        "btc-volume"
      ]
    },
    "btc-mcap": {
      "type": "Metric",
      "props": {
        "label": "Market Cap",
        "value": {
          "$state": "/state/priceFormat/bitcoin/marketCap"
        },
        "trend": "neutral"
      },
      "children": []
    },
    "btc-volume": {
      "type": "Metric",
      "props": {
        "label": "24h Volume",
        "value": {
          "$state": "/state/priceFormat/bitcoin/volume24h"
        },
        "trend": "neutral"
      },
      "children": []
    },
    "eth-card": {
      "type": "Card",
      "props": {
        "title": "Ethereum (ETH)",
        "maxWidth": "full"
      },
      "children": [
        "eth-stack"
      ]
    },
    "eth-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "eth-price",
        "eth-kpis"
      ]
    },
    "eth-price": {
      "type": "Metric",
      "props": {
        "label": "Current Price",
        "value": {
          "$state": "/state/priceFormat/ethereum/price"
        },
        "detail": {
          "$state": "/state/priceFormat/ethereum/detail"
        },
        "trend": "down"
      },
      "children": []
    },
    "eth-metrics": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "sm"
      },
      "children": [
        "eth-mcap",
        "eth-volume"
      ]
    },
    "eth-mcap": {
      "type": "Metric",
      "props": {
        "label": "Market Cap",
        "value": {
          "$state": "/state/priceFormat/ethereum/marketCap"
        },
        "trend": "neutral"
      },
      "children": []
    },
    "eth-volume": {
      "type": "Metric",
      "props": {
        "label": "24h Volume",
        "value": {
          "$state": "/state/priceFormat/ethereum/volume24h"
        },
        "trend": "neutral"
      },
      "children": []
    },
    "sol-card": {
      "type": "Card",
      "props": {
        "title": "Solana (SOL)",
        "maxWidth": "full"
      },
      "children": [
        "sol-stack"
      ]
    },
    "sol-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "sol-price",
        "sol-kpis"
      ]
    },
    "sol-price": {
      "type": "Metric",
      "props": {
        "label": "Current Price",
        "value": {
          "$state": "/state/priceFormat/solana/price"
        },
        "detail": {
          "$state": "/state/priceFormat/solana/detail"
        },
        "trend": "down"
      },
      "children": []
    },
    "sol-metrics": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "sm"
      },
      "children": [
        "sol-mcap",
        "sol-volume"
      ]
    },
    "sol-mcap": {
      "type": "Metric",
      "props": {
        "label": "Market Cap",
        "value": {
          "$state": "/state/priceFormat/solana/marketCap"
        },
        "trend": "neutral"
      },
      "children": []
    },
    "sol-volume": {
      "type": "Metric",
      "props": {
        "label": "24h Volume",
        "value": {
          "$state": "/state/priceFormat/solana/volume24h"
        },
        "trend": "neutral"
      },
      "children": []
    },
    "trend-grid": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "btc-trend",
        "eth-trend",
        "sol-trend"
      ]
    },
    "btc-trend": {
      "type": "Card",
      "props": {
        "title": "Bitcoin Trend",
        "maxWidth": "full"
      },
      "children": [
        "btc-chart"
      ]
    },
    "btc-chart": {
      "type": "LineChart",
      "props": {
        "title": "30-Day Price",
        "data": {
          "$state": "/state/history30d/bitcoin"
        },
        "xKey": "date",
        "yKey": "price",
        "color": "#F7931A",
        "height": 240
      },
      "children": []
    },
    "eth-trend": {
      "type": "Card",
      "props": {
        "title": "Ethereum Trend",
        "maxWidth": "full"
      },
      "children": [
        "eth-chart"
      ]
    },
    "eth-chart": {
      "type": "LineChart",
      "props": {
        "title": "30-Day Price",
        "data": {
          "$state": "/state/history30d/ethereum"
        },
        "xKey": "date",
        "yKey": "price",
        "color": "#627EEA",
        "height": 240
      },
      "children": []
    },
    "sol-trend": {
      "type": "Card",
      "props": {
        "title": "Solana Trend",
        "maxWidth": "full"
      },
      "children": [
        "sol-chart"
      ]
    },
    "sol-chart": {
      "type": "LineChart",
      "props": {
        "title": "30-Day Price",
        "data": {
          "$state": "/state/history30d/solana"
        },
        "xKey": "date",
        "yKey": "price",
        "color": "#14F195",
        "height": 240
      },
      "children": []
    },
    "history-card": {
      "type": "Card",
      "props": {
        "title": "Key Market Stats",
        "description": "Compare core metrics across the three assets",
        "maxWidth": "full"
