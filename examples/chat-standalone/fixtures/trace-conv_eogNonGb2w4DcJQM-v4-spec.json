          },
          {
            "value": "sources",
            "label": "Sources"
          }
        ]
      },
      "children": [
        "tab-supply",
        "tab-performance",
        "tab-sources"
      ]
    },
    "tab-supply": {
      "type": "TabContent",
      "props": {
        "value": "supply"
      },
      "children": [
        "supply-card"
      ]
    },
