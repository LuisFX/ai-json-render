# Provider selection
# - openai: use OPENAI_API_KEY + OPENAI_MODEL (default when only OpenAI key is set)
# - gateway: use Vercel AI Gateway (AI_GATEWAY_API_KEY)
# - opencode: use a running `opencode serve` (OPENCODE_*)
# Server default for /api/generate when body.provider is omitted:
AI_PROVIDER=openai
# Client UI default for the provider toggle (and hide selectors when =gateway):
# NEXT_PUBLIC_AI_PROVIDER=opencode

# OpenAI (direct)
OPENAI_API_KEY=
# Seeds UI model selector if enabled in lib/openai-model-matrix.ts
OPENAI_MODEL=gpt-5.4-mini

# TypeSafe Jev (jev toggle via @typesafe-ai/sdk)
# Native TypeSafe key, not a Vercel AI Gateway key.
TYPESAFE_API_KEY=

# Vercel AI Gateway
# Automatically authenticated when deployed on Vercel
# For local development, get your key from https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# AI Gateway model (provider/model). Default: anthropic/claude-haiku-4.5
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Rate Limiting (Upstash Redis)
# Optional - rate limiting is disabled when these are not set
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# OpenCode (AI_PROVIDER=opencode or UI provider=opencode) — requires a running `opencode serve`
# Pick a model from `opencode models` that your auth covers.
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_MODEL=openai/gpt-5-mini
# OPENCODE_DIRECTORY=/absolute/path/to/examples/chat-standalone/fixtures/opencode-lab
#   (in-repo fixture — see fixtures/opencode-lab/README.md; was /tmp/opencode-lab-scratch)
# OPENCODE_SHARE_SESSION=1  # lab only: demonstrate shared-session footgun
# OPENCODE_AGENT=build
# NEXT_PUBLIC_OPENCODE_MODEL=openai/gpt-5-mini

# AI SDK → Langfuse (Next.js exporter). Keys already used by marketplace-style apps.
# LANGFUSE_BASE_URL (underscore) — JS SDK. Serve plugin uses LANGFUSE_BASEURL (no underscore).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://127.0.0.1:51793

# AI SDK experimental_telemetry on ToolLoopAgent (set to 0 to disable Langfuse export too)
# AI_TELEMETRY=0
