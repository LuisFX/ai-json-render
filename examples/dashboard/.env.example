# Database
# Use port 15432 for ai-render-infra (pnpm db:setup)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/json_render_dashboard_example

# AI (optional - for UI generation)
# Anthropic (direct API - preferred when set)
ANTHROPIC_API_KEY=

# Vercel AI Gateway (fallback)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5
