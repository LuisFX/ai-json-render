# Anthropic (direct API - preferred when set)
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Vercel AI Gateway (fallback when ANTHROPIC_API_KEY is not set)
# Automatically authenticated when deployed on Vercel
# For local development, get your key from https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# AI Model Configuration (use AI_MODEL or AI_GATEWAY_MODEL)
# Claude Haiku 4.5 (recommended alias - always latest patch)
# See https://docs.anthropic.com/en/docs/about-claude/models
AI_MODEL=claude-haiku-4-5
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Force provider when both keys exist: anthropic | gateway
# AI_PROVIDER=anthropic

# Vercel KV (Rate Limiting)
# Automatically populated when you add Vercel KV to your project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Rate Limiting
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
