# OpenAI (default playground model via @ai-sdk/openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# TypeSafe Jev (playground jev toggle via @typesafe-ai/sdk)
# Native TypeSafe key, not a Vercel AI Gateway key.
TYPESAFE_API_KEY=

# Optional Vercel AI Gateway fallback when OPENAI_API_KEY is unset
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Vercel KV (Rate Limiting)
# Automatically populated when you add Vercel KV to your project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Rate Limiting
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
